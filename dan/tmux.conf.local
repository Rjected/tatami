# Dan's overrides for oh-my-tmux (~/.tmux.conf sources this file).
# One movement language with nvim and tatami (table in ~/projects/tatami/dan/tatami.conf).

# Focus: C-hjkl without the prefix, crossing between nvim splits and tmux panes.
# smart-splits.nvim marks panes running nvim with @pane-is-vim.
bind -n C-h if -F "#{@pane-is-vim}" 'send-keys C-h' 'select-pane -L'
bind -n C-j if -F "#{@pane-is-vim}" 'send-keys C-j' 'select-pane -D'
bind -n C-k if -F "#{@pane-is-vim}" 'send-keys C-k' 'select-pane -U'
bind -n C-l if -F "#{@pane-is-vim}" 'send-keys C-l' 'select-pane -R'
bind -T copy-mode-vi C-h select-pane -L
bind -T copy-mode-vi C-j select-pane -D
bind -T copy-mode-vi C-k select-pane -U
bind -T copy-mode-vi C-l select-pane -R
# C-l used to clear the screen: that is prefix C-l now.
bind C-l send-keys C-l \; clear-history

# Split like nvim ,h (stacked) and ,v (side by side)
bind h split-window -v -c "#{pane_current_path}"
bind v split-window -h -c "#{pane_current_path}"

# Resize like nvim ,k ,j ,l: taller, shorter, wider (repeatable)
bind -r k run -C 'resize-pane -y #{e|+:#{pane_height},2}'
bind -r j run -C 'resize-pane -y #{e|-:#{pane_height},2}'
bind -r l run -C 'resize-pane -x #{e|+:#{pane_width},4}'

# Previous / next window like nvim S-h / S-l
bind -r H previous-window
bind -r L next-window
unbind J
unbind K
unbind C-h

# Move the pane like nvim C-w HJKL
bind C-w switch-client -T pane-move
bind -T pane-move H swap-pane -d -t '{left-of}'
bind -T pane-move J swap-pane -d -t '{down-of}'
bind -T pane-move K swap-pane -d -t '{up-of}'
bind -T pane-move L swap-pane -d -t '{right-of}'
